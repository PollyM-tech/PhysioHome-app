# Local development only. Copy to backend/.env and generate unique secret values.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=physiohome
POSTGRES_USER=physiohome
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Expo web origin. Native applications do not use browser CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8081

PUBLIC_API_ORIGIN=http://localhost:8001

# Production recovery email (development uses console email):
# DEFAULT_FROM_EMAIL=PhysioHome <noreply@your-domain.example>
# EMAIL_HOST=smtp.your-provider.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# Production shared throttle cache; initialize with manage.py createcachetable:
# CACHE_URL=dbcache://physiohome_cache
# Optional server-restricted Google Places API key for full place search.
# Without it, a limited Kenya-area directory and map pin/GPS selection remain available.
GOOGLE_MAPS_API_KEY=

# Requires a native development/production build and APNs/FCM credentials in EAS.
EXPO_PUSH_ENABLED=False
EXPO_PUSH_ACCESS_TOKEN=

# Owner-confirmed direct Paybill with Daraja access; no payment adapter is enabled.
# These values document setup only; payment integration is not enabled.
MPESA_ENABLED=False
MPESA_PAYBILL=4125123
MPESA_ACCOUNT_NAME=PhysioHome
# Future adapter: configure secrets privately and verify with sandbox before live charging.
# Never commit Daraja consumer secrets, passkeys or production credentials.

# Daraja sandbox first: use its test shortcode/passkey, not production values.
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Public HTTPS origin only, e.g. https://api.your-domain.example
MPESA_CALLBACK_ORIGIN=
