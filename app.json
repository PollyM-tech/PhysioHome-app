{
  "expo": {
    "name": "physiohome-app",
    "slug": "physiohome-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/physiohome-icon.png",
    "scheme": "physiohomeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/logo/physiohome-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/physiohome-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6ECDD"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PhysioHome to use your location to choose a service area or home-visit address."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
