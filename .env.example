# Django API origin. For a physical device, use an accessible LAN/tunnel address.
EXPO_PUBLIC_PHYSIOHOME_API_ORIGIN=http://localhost:8001
# Android map SDK builds need an application/signature-restricted Maps SDK key.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Optional web tile provider override (include attribution appropriate to the provider).
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Google map renderers; use separately restricted client keys.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# Optional attribution HTML when using a different web tile provider.
EXPO_PUBLIC_MAP_ATTRIBUTION=

# EAS project UUID used for native opt-in push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
